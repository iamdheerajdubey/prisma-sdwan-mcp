# Copy to .env and fill in. Never commit a real .env.
#
# This is everything. Every other setting has a working default in code --
# see docs/CONFIGURATION.md if you ever need to change one.

# --- Prisma SD-WAN controller ----------------------------------------------
PAN_CLIENT_ID=
PAN_CLIENT_SECRET=
PAN_TSG_ID=

# --- ION device SSH (run_commands) -----------------------------------------
# Blank disables device access: with no credential the tool fails closed
# before any network activity.
ION_USERNAME=
ION_PASSWORD=

# --- Diagnostic probe only (probe/run_probe.py) ----------------------------
# The server ignores both of these.

# Which ION the probe connects to.
ION_IP=

# An element NAME the controller knows, e.g. AEDXB01-SDE01. Exercises the
# name -> site -> element -> address path, which is what the AI actually uses
# when a user asks for a site by name. Blank means that check is recorded as
# "not exercised" rather than guessed at. Needs the PAN_* credentials above.
ION_ELEMENT=
