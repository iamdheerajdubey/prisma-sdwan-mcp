# Copy to .env and fill in. Never commit a real .env.
#
# This is everything the server reads. Every other setting has a working
# default in code -- see docs/CONFIGURATION.md if you ever need to change one.

# --- Prisma SD-WAN controller ----------------------------------------------
PAN_CLIENT_ID=
PAN_CLIENT_SECRET=
PAN_TSG_ID=

# --- ION device SSH (run_commands) -----------------------------------------
# Blank disables device access: with no credential the tool fails closed
# before any network activity. Use ION_PRIVATE_KEY instead of ION_PASSWORD for
# key auth -- set one or the other, never both.
ION_USERNAME=
ION_PASSWORD=
