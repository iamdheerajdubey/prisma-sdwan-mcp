# Required
PAN_CLIENT_ID=
PAN_CLIENT_SECRET=
PAN_TSG_ID=

# Optional. The SDK normally uses this controller.
PAN_CONTROLLER=https://api.sase.paloaltonetworks.com

# Response guardrails
MCP_MAX_RESPONSE_BYTES=40960
MCP_DEFAULT_PAGE_SIZE=50
MCP_MAX_PAGE_SIZE=200
MCP_MAX_FANOUT=100

# Expert registry access. Keeps the full read-only registry reachable.
MCP_EXPERT_TOOL_ENABLED=true

# If false, actions marked requires_live_test are blocked from the generic expert tool.
# Semantic tools still expose them directly, independent of this flag.
MCP_ALLOW_UNVERIFIED_COMPAT=false

# ION CLI passthrough (run_commands). Leaving these unset disables the tool
# entirely: with no credential configured (and none supplied per call), every
# call fails closed with a configuration error before any network activity.
# Set the username and exactly ONE of password / private key. Leave the other
# commented out rather than blank -- a blank value used to read as "configured"
# and refuse the credential you did set (fixed, but there is no reason to write
# a line that means nothing).
PRISMA_ION_USERNAME=
PRISMA_ION_PASSWORD=
#PRISMA_ION_PRIVATE_KEY=
#PRISMA_ION_PRIVATE_KEY_PASSPHRASE=

# Host-key verification. There is no first-use trust: an ION whose key is not
# already on record is refused before any credential is sent.
#
# Unset means "whatever the SSH client uses by default" — ~/.ssh/known_hosts,
# expanded per-platform, so the same value works on Linux and Windows. On a
# fresh server or inside a container that file does not exist, every
# connection fails, and the only remedy would be an interactive `ssh` login as
# the same OS user. Point this at a provisioned file instead. `~` is expanded.
#
#   ssh-keyscan -H <ion-address> >> /etc/prisma/ion_known_hosts
#
# Verify the fingerprint out of band before trusting it: this file is the
# whole boundary against a spoofed device.
PRISMA_ION_KNOWN_HOSTS=

# ION CLI tuning. All optional.
PRISMA_ION_SSH_PORT=22
PRISMA_ION_PROBE_TIMEOUT=3
PRISMA_ION_CONNECT_TIMEOUT=10
PRISMA_ION_READ_TIMEOUT=300
PRISMA_ION_MAX_OUTPUT_BYTES=40960
PRISMA_ION_MAX_COMMANDS=10

# ---------------------------------------------------------------------------
# Diagnostic probe (probe/run_probe.py)
#
# Three lines. What you would need to SSH into the box by hand, nothing more.
# Everything else has a working default, including the host key, which the
# probe records itself.
#
# WARNING: the probe captures full raw device output on purpose -- that is the
# only way to tell whether redaction missed a secret. Whatever your ION prints
# lands in probe/results/ and therefore in git. Use a device you are willing to
# expose and treat the repo as sensitive afterwards.
# ---------------------------------------------------------------------------
ION_IP=
ION_USERNAME=
ION_PASSWORD=

# Optional: an element NAME the controller knows, to also exercise the
# name-to-address path. Needs the PAN_* credentials above. Blank means that
# check is recorded as "not exercised" rather than guessed at.
ION_ELEMENT=
