# Prisma SASE Service Account Credentials
# Copy this file to .env and fill in your values
#
# See README.md for instructions on creating a service account

PAN_CLIENT_ID=myaccount@1234567890.iam.panserviceaccount.com
PAN_CLIENT_SECRET=your-client-secret-here
PAN_TSG_ID=1234567890
# Advisory only; the SDK derives the tenant region after login.
PAN_REGION=americas
# Optional private or QA controller override.
# PAN_CONTROLLER=https://api.sase.paloaltonetworks.com
# Maximum serialized MCP response size in bytes.
PRISMA_MCP_MAX_RESPONSE_BYTES=40960
# Local directory for generated site configuration files; defaults to cwd.
# PRISMA_MCP_OUTPUT_DIR=
